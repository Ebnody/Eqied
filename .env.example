# EthioBudget Tracker - Environment Variables
# Copy this file to .env (cp .env.example .env) and fill in the values.

# Database (PostgreSQL via Neon for local + production)
# Use the pooled connection string for DATABASE_URL (add ?pgbouncer=true if needed)
# Use the direct connection string for DIRECT_DATABASE_URL (for Prisma migrations)
DATABASE_URL="postgresql://user:password@ep-xyz.neon.tech/dbname?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@ep-xyz.neon.tech/dbname?sslmode=require"

# JWT secret for session tokens (generate a long random string for production)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-me-in-production-use-a-long-random-string"

# Telegram Bot
# 1. Open https://t.me/BotFather on Telegram
# 2. Send /newbot and follow instructions
# 3. Copy the token here
# 4. Set the bot username so users can find it
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Public app URL (used to register the Telegram webhook in production)
# Production: e.g. https://ethiobudget.example.com or your Vercel domain
APP_URL=""

# Telegram webhook secret token (recommended in production)
TELEGRAM_WEBHOOK_SECRET=""
